{
  "name": "tinor-api-v3",
  "version": "3.3.0",
  "description": "API backend TinOR V3 — BD Gestion Commerciale V3 (Express + MariaDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:test": "node src/server.js --test",
    "dev:test": "node --watch src/server.js --test",
    "migrate": "node scripts/migrate.js",
    "migrate:test": "node scripts/migrate.js --test",
    "seed": "node scripts/seed.js",
    "setup": "node scripts/init-env.js && npm run migrate && npm run seed",
    "demo": "node scripts/seed_test_complet.js",
    "reset:demo": "node scripts/reset-demo.js",
    "reset:test": "node scripts/reset-demo.js --test --confirmer",
    "backup": "node scripts/backup.js",
    "backup:test": "node scripts/backup.js --test",
    "test:stock": "node test/stock/run.js",
    "creer:reel": "node scripts/creer-reel.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3"
  }
}
