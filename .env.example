# Copier ce fichier en .env et adapter les valeurs.

# Option A — une URL de connexion unique (pratique avec Railway, PlanetScale, Aiven)
# DATABASE_URL=mysql://user:password@host:3306/tinor_v3

# Option B — variables séparées (pratique avec un hébergement mutualisé cPanel classique)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tinor
DB_PASSWORD=tinor
DB_NAME=tinor_v3

# Clé secrète pour signer les tokens JWT — à changer impérativement en production
# (générer une chaîne aléatoire longue, ex: openssl rand -hex 32). Absente ou d'exemple : clé aléatoire à chaque démarrage.
JWT_SECRET=change-moi-en-production

PORT=3001
NODE_ENV=development

# Sécurité (facultatif)
# CORS_ORIGINS=https://tinor.exemple.tn          # autres sites autorisés à appeler l'API (réseau local et application Android déjà acceptés)
# TLS_CERT=/chemin/fullchain.pem                 # HTTPS direct (sinon proxy HTTPS + TRUST_PROXY=1, voir DEPLOIEMENT.md)
# TLS_KEY=/chemin/privkey.pem
# SMTP_HOST=smtp.exemple.tn                      # envoi des factures par e-mail (voir DEPLOIEMENT.md)
# SMTP_PORT=587
# SMTP_USER=facturation@exemple.tn
# SMTP_PASSWORD=
# SMTP_FROM="Jardins de Jerba <facturation@exemple.tn>"
